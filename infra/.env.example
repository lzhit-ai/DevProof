# 复制为 infra/.env 供本地 Compose 使用。请勿将 infra/.env 提交到 git。
POSTGRES_DB=ai_codereview
POSTGRES_USER=ai_codereview
POSTGRES_PASSWORD=replace-with-a-local-secret
JWT_SECRET=replace-with-a-local-secret-that-is-at-least-32-characters

# 生成模型供应商：任意 OpenAI 兼容的 chat/completions 服务（deepseek、
# siliconflow 等）。使用 OpenAI 接口。
GENERATION_PROVIDER=deepseek
GENERATION_MODEL=deepseek-v4-flash
GENERATION_BASE_URL=https://api.deepseek.com
# GENERATION_API_KEY=replace-with-a-local-secret

# 向量模型供应商：任意 OpenAI 兼容的 /embeddings 服务（dashscope、
# siliconflow 等）。使用 OpenAI 接口。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
# 使用你的模型工作空间的 OpenAI 兼容端点。
EMBEDDING_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=replace-with-a-local-secret
# 必须与所选向量模型的输出维度一致（dashscope
# text-embedding-v4 = 768，SiliconFlow BAAI/bge-m3 = 1024）。修改它需要
# 重新运行迁移（会清空已存向量）并重建检索索引。
EMBEDDING_DIMENSIONS=768

# HTTP_QUERY 工具在其精确 HTTPS 主机名被加入白名单前保持禁用。
# AGENT_TOOL_ALLOWED_HOSTS=["api.example.internal"]
# GitHub 来源连接是只读的。创建连接时填这个环境变量名，而非 token 值；
# 公开仓库可以省略密钥引用。
# GITHUB_SOURCE_TOKEN=replace-with-a-read-only-github-token

# 在线 MinerU 文档解析（替代本地）。在 https://mineru.net/apiManage/docs
# -> 精准解析 API 创建 token。解析二进制文档（PDF、Office、图片）时必须配置；
# 纯文本/结构化文本来源可本地解析，无需此 token。
# MINERU_API_TOKEN=replace-with-your-mineru-api-token
# MINERU_MODEL_VERSION=pipeline
# MINERU_FORCE_OCR=true

# Personal model credentials: base64 of 32 random bytes. Keep this key stable and backed up.
MODEL_CREDENTIAL_ENCRYPTION_KEY=
