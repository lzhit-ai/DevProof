# 复制为 infra/.env.prod 后填写。该文件仅保存服务器，绝不提交或上传。
POSTGRES_DB=ai_codereview
POSTGRES_USER=ai_codereview
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
JWT_SECRET=replace-with-at-least-32-random-characters

# 任意 OpenAI 兼容的文本生成模型。
GENERATION_PROVIDER=deepseek
GENERATION_MODEL=deepseek-v4-flash
GENERATION_BASE_URL=https://api.deepseek.com
GENERATION_API_KEY=replace-with-generation-api-key

# 任意 OpenAI 兼容的 Embedding 模型；维度必须与模型输出一致。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_DIMENSIONS=768

# 私有 GitHub 仓库才需要；在页面中填 GITHUB_SOURCE_TOKEN 作为凭据引用。
# GITHUB_SOURCE_TOKEN=replace-with-read-only-github-token

# 解析 PDF、Office 或图片才需要。
# MINERU_API_TOKEN=replace-with-mineru-api-token
MINERU_MODEL_VERSION=pipeline
MINERU_FORCE_OCR=true

# HTTP_QUERY Agent 工具使用时填入允许访问的精确 HTTPS 主机名 JSON 数组。
# AGENT_TOOL_ALLOWED_HOSTS=["api.example.com"]
