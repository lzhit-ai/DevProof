server {
    listen 80;
    listen [::]:80;
    server_name ${DEVPROOF_SERVER_NAME};
    location = /health/live { default_type text/plain; return 200 'ok\n'; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${DEVPROOF_SERVER_NAME};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 502m;
    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $business http://business:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location ~ ^/api/v1/cycles/[^/]+/git-snapshots$ { proxy_read_timeout 650s; proxy_pass $business; }
    location ~ ^/api/v1/projects/[^/]+/delivery-items/[^/]+/discover-platform-links$ { proxy_read_timeout 650s; proxy_pass $business; }
    location /api/v1/ { proxy_pass $business; }
    location /api/ { return 404; }
    location /internal/ { return 404; }
    location / { try_files $uri $uri/ /index.html; }
}
