# Copy to infra/.env.devproof.prod on the server. Keep existing DB/JWT values during handoff.
POSTGRES_DB=ai_codereview
POSTGRES_USER=ai_codereview
POSTGRES_PASSWORD=
JWT_SECRET=

# Original production project name is ai-codereview. Keep it when retaining its volumes.
PUBLIC_SERVER_NAME=your-domain.example
JAVA_CORS_ORIGINS=https://your-domain.example
TLS_CERT_DIR=/etc/ai-codereview/certs
DEVPROOF_IMAGE_TAG=local

# Generate independent secrets; the Worker token must match its entry in Java's JSON map.
AGENT_WORKER_ID=agent-worker-prod-1
AGENT_SERVICE_TOKEN=
AGENT_WORKER_CREDENTIALS=
COMPUTE_SERVICE_TOKEN=

GENERATION_PROVIDER=deepseek
GENERATION_MODEL=deepseek-v4-flash
GENERATION_BASE_URL=https://api.deepseek.com
GENERATION_API_KEY=
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
GITHUB_SOURCE_TOKEN=
GIT_CREDENTIAL_REFS=GITHUB_SOURCE_TOKEN
GITHUB_SOURCE_SECRET_REFS=GITHUB_SOURCE_TOKEN
MINERU_API_TOKEN=

# HTTP tools use exact allowed hosts and environment variable names, never raw credentials.
AGENT_TOOL_ALLOWED_HOSTS=
AGENT_TOOL_SECRET_REFS=

# Initial resource bounds; size from actual workload before increasing concurrency.
BUSINESS_MEMORY_LIMIT=1g
BUSINESS_CPU_LIMIT=2
AGENT_MEMORY_LIMIT=2g
AGENT_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=256m
REDIS_MAXMEMORY=128mb
FRONTEND_MEMORY_LIMIT=128m

# Personal model credentials: base64 of 32 random bytes. Keep this key stable and backed up.
MODEL_CREDENTIAL_ENCRYPTION_KEY=
