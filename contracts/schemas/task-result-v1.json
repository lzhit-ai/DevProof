{
  "$defs": {
    "FrozenInputRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "VERIFICATION",
            "PLANNING",
            "CLAIM_PROPOSAL",
            "EVIDENCE_QUESTION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "contentHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "schemaVersion": {
          "minLength": 1,
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "contentHash",
        "schemaVersion"
      ],
      "title": "FrozenInputRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "agent-task-v1",
      "title": "Contractversion",
      "type": "string"
    },
    "taskId": {
      "format": "uuid",
      "title": "Taskid",
      "type": "string"
    },
    "attemptId": {
      "format": "uuid",
      "title": "Attemptid",
      "type": "string"
    },
    "fencingToken": {
      "minimum": 1,
      "title": "Fencingtoken",
      "type": "integer"
    },
    "workerId": {
      "minLength": 1,
      "title": "Workerid",
      "type": "string"
    },
    "correlationId": {
      "minLength": 1,
      "title": "Correlationid",
      "type": "string"
    },
    "inputSnapshotRef": {
      "$ref": "#/$defs/FrozenInputRef"
    },
    "resultSchemaVersion": {
      "minLength": 1,
      "title": "Resultschemaversion",
      "type": "string"
    },
    "resultHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Resulthash",
      "type": "string"
    },
    "evidenceRefs": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidencerefs",
      "type": "array"
    },
    "candidatesJson": {
      "minLength": 1,
      "title": "Candidatesjson",
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "taskId",
    "attemptId",
    "fencingToken",
    "workerId",
    "correlationId",
    "inputSnapshotRef",
    "resultSchemaVersion",
    "resultHash",
    "evidenceRefs",
    "candidatesJson"
  ],
  "title": "AgentTaskResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devproof:contracts:task-result-v1"
}
