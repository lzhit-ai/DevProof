{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devproof:contracts:verification-input-v2",
  "title": "Frozen verification input v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cycleId", "purpose", "assessmentProfile", "policyVersion", "workflowVersion", "sources"],
  "properties": {
    "schemaVersion": {"const": "verification-input-v2"},
    "cycleId": {"$ref": "#/$defs/uuid"},
    "purpose": {"enum": ["PREPARATION", "FORMAL"]},
    "assessmentProfile": {"const": "DELIVERY_VERIFICATION"},
    "policyVersion": {"const": "v2"},
    "workflowVersion": {"const": "v1"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "content_hash", "title", "body", "web_url", "excerptSafe"], "properties": {
      "id": {"$ref": "#/$defs/uuid"}, "content_hash": {"$ref": "#/$defs/hash"}, "title": {"type": "string"}, "body": {"type": "string"}, "web_url": {"type": "string"}, "excerptSafe": {"type": "string"}
    }},
    "deliveryItemId": {"$ref": "#/$defs/uuid"},
    "deliveryClaims": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "key", "text", "origin", "sourceManifest", "contentHash"], "properties": {
      "id": {"$ref": "#/$defs/uuid"}, "key": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 3}, "origin": {"enum": ["MODEL", "HUMAN"]},
      "sourceManifest": {"type": "object"}, "contentHash": {"$ref": "#/$defs/hash"}
    }}},
    "git": {"type": "object", "additionalProperties": false, "required": ["id", "repository_id", "base_sha", "target_sha", "merge_base_sha", "effective_base_sha", "diff_mode", "diff_hash", "diff_artifact_id", "code_change_artifact_id"], "properties": {
      "id": {"$ref": "#/$defs/uuid"}, "repository_id": {"$ref": "#/$defs/uuid"}, "base_sha": {"type": "string"}, "target_sha": {"type": "string"}, "merge_base_sha": {"type": "string"},
      "effective_base_sha": {"type": ["string", "null"]}, "diff_mode": {"enum": ["TWO_DOT", "THREE_DOT"]}, "diff_hash": {"$ref": "#/$defs/hash"},
      "diff_artifact_id": {"$ref": "#/$defs/uuid"}, "code_change_artifact_id": {"$ref": "#/$defs/uuid"}
    }},
    "codeChangeArtifactHash": {"$ref": "#/$defs/hash"},
    "externalEvidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "content_hash", "commit_sha", "evidence_type", "logical_name", "exit_code", "excerptSafe"], "properties": {
      "id": {"$ref": "#/$defs/uuid"}, "content_hash": {"$ref": "#/$defs/hash"}, "commit_sha": {"type": "string"}, "evidence_type": {"enum": ["TEST", "BUILD"]}, "logical_name": {"type": "string"}, "exit_code": {"type": ["integer", "null"]}, "excerptSafe": {"type": "string"}
    }}},
    "manualEvidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "content_hash", "submitted_by", "logical_name", "origin_type", "origin", "excerptSafe"], "properties": {
      "id": {"$ref": "#/$defs/uuid"}, "content_hash": {"$ref": "#/$defs/hash"}, "submitted_by": {"$ref": "#/$defs/uuid"}, "logical_name": {"type": "string"}, "origin_type": {"type": "string"}, "origin": {"type": "object"}, "excerptSafe": {"type": "string"}
    }}},
    "planBaseline": {"type": "object", "additionalProperties": false, "required": ["selectionId", "selectionHash", "planVersionId", "planContentHash"], "properties": {
      "selectionId": {"$ref": "#/$defs/uuid"}, "selectionHash": {"$ref": "#/$defs/hash"}, "planVersionId": {"$ref": "#/$defs/uuid"}, "planContentHash": {"$ref": "#/$defs/hash"}
    }}
  },
  "allOf": [{"if": {"properties": {"purpose": {"const": "FORMAL"}}}, "then": {"required": ["requirement", "deliveryItemId", "deliveryClaims", "git", "codeChangeArtifactHash", "externalEvidence", "manualEvidence"]},
    "else": {"properties": {"sources": {"minItems": 1}}, "not": {"anyOf": [{"required": ["requirement"]}, {"required": ["deliveryItemId"]}, {"required": ["deliveryClaims"]}, {"required": ["git"]}, {"required": ["codeChangeArtifactHash"]}, {"required": ["externalEvidence"]}, {"required": ["manualEvidence"]}, {"required": ["planBaseline"]}]}}}],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "content_hash", "parser_version", "processing_status", "chunks"], "properties": {
      "id": {"$ref": "#/$defs/uuid"}, "content_hash": {"$ref": "#/$defs/hash"}, "parser_version": {"type": ["string", "null"]}, "processing_status": {"type": "string"},
      "chunks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "chunk_index", "index_version", "text_hash", "locator", "excerptSafe", "extractorVersion"], "properties": {
        "id": {"$ref": "#/$defs/uuid"}, "chunk_index": {"type": "integer"}, "index_version": {"type": "string"}, "text_hash": {"$ref": "#/$defs/hash"}, "locator": {"type": "object"}, "excerptSafe": {"type": "string"}, "extractorVersion": {"type": "string"}
      }}}
    }}
  }
}
