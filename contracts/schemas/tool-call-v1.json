{
  "$defs": {
    "FrozenInputRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "VERIFICATION",
            "PLANNING",
            "CLAIM_PROPOSAL",
            "EVIDENCE_QUESTION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "contentHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "schemaVersion": {
          "minLength": 1,
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "contentHash",
        "schemaVersion"
      ],
      "title": "FrozenInputRef",
      "type": "object"
    },
    "JsonValue": {},
    "RegisteredVersion": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "RegisteredVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "agent-task-v1",
      "title": "Contractversion",
      "type": "string"
    },
    "taskId": {
      "format": "uuid",
      "title": "Taskid",
      "type": "string"
    },
    "attemptId": {
      "format": "uuid",
      "title": "Attemptid",
      "type": "string"
    },
    "fencingToken": {
      "minimum": 1,
      "title": "Fencingtoken",
      "type": "integer"
    },
    "workerId": {
      "minLength": 1,
      "title": "Workerid",
      "type": "string"
    },
    "correlationId": {
      "minLength": 1,
      "title": "Correlationid",
      "type": "string"
    },
    "toolCallId": {
      "format": "uuid",
      "title": "Toolcallid",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/RegisteredVersion"
    },
    "inputSnapshotRef": {
      "$ref": "#/$defs/FrozenInputRef"
    },
    "arguments": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Arguments",
      "type": "object"
    }
  },
  "required": [
    "contractVersion",
    "taskId",
    "attemptId",
    "fencingToken",
    "workerId",
    "correlationId",
    "toolCallId",
    "tool",
    "inputSnapshotRef",
    "arguments"
  ],
  "title": "AgentToolCall",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devproof:contracts:tool-call-v1"
}
