                    "SUPPORTED",
                    "UNSUPPORTED",
                    "NEEDS_HUMAN"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
